<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        android:title="@string/settings_logging">
        <ListPreference
            android:defaultValue="1"
            android:entries="@array/logging_level_texts"
            android:entryValues="@array/logging_level_values"
            android:icon="@drawable/inbox_text_24"
            android:key="loggingLevel"
            android:summary="%s"
            app:singleLineTitle="false"
            android:title="@string/settings_logging_level" />
        <ListPreference
            android:defaultValue="512"
            android:entries="@array/max_log_size_entries"
            android:entryValues="@array/max_log_size_values"
            android:icon="@drawable/outline_sd_storage_24"
            android:key="maxLogSize"
            android:summary="%s"
            app:singleLineTitle="false"
            android:title="@string/settings_max_log_size" />
        <!-- TODO: Add detailed interception log toggle (add another screen for details) -->
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
